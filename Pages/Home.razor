@page "/"
@using MerryChristmasTree.Web.Services
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>🎄 Merry Christmas Tree</PageTitle>

<div class="app-container @(_isCrtActive ? "crt-active" : "")"
     @onkeydown="HandleKeyDown"
     tabindex="0"
     autofocus
     id="main-container">

    <!-- Canvas fills 100% of the browser window area -->
    <canvas id="treeCanvas" @ref="_canvasRef"></canvas>

    @if (_isConsoleIntroActive)
    {
        <div class="console-intro @(_isFadingOut ? "fading-out" : "")" @onclick="SkipConsoleIntroAsync">
            <div class="console-window">
                <div class="console-titlebar">
                    <div class="console-dots">
                        <span class="console-dot red"></span>
                        <span class="console-dot yellow"></span>
                        <span class="console-dot green"></span>
                    </div>
                    <span>northpole-shell — bash</span>
                    <span></span>
                </div>
                <div class="console-body">
                    <div>
                        <div class="console-prompt-line">
                            <span class="console-user">santa@northpole</span><span>:</span><span class="console-path">~/tree</span><span>$</span>
                            <span class="console-cmd">@_typedCommand</span>@if (!_commandSubmitted) {<span class="console-cursor"></span>}
                        </div>

                        @if (_commandSubmitted)
                        {
                            <div class="console-output">
                                <div><span class="console-ok">[OK]</span> Initializing festive ASCII renderer...</div>
                                @if (_showSecondLog)
                                {
                                    <div><span class="console-ok">[OK]</span> Starting MerryChristmasTree.Web...</div>
                                }
                            </div>
                        }

                        @if (_waitingForLaunchGesture)
                        {
                            <div class="console-ready-prompt">
                                &gt; Press [ENTER] <span class="console-cursor"></span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Hidden native audio element -->
    <audio id="bg-audio" loop src="Wham_Last_Christmas.mp3" preload="auto" @ref="_audioRef"></audio>
</div>

@code {
    private const string IntroCommand = "run christmas";

    private ElementReference _canvasRef;
    private ElementReference _audioRef;
    private DotNetObjectReference<Home>? _dotNetRef;
    private readonly TreeEngine _engine = new();
    private CancellationTokenSource? _introCts;

    private bool _isCrtActive = false;
    private bool _isConsoleIntroActive = true;
    private bool _isTreeRenderEnabled = false;
    private bool _isFadingOut = false;
    private bool _commandSubmitted = false;
    private bool _showSecondLog = false;
    private bool _waitingForLaunchGesture = false;
    private string _typedCommand = "";

    protected override void OnInitialized()
    {
        _engine.Initialize(TreeEngine.DefaultWidth, TreeEngine.DefaultHeight);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "treeTerminal.init",
                _canvasRef,
                _audioRef,
                _dotNetRef);

            _introCts = new CancellationTokenSource();
            _ = RunConsoleIntroAsync(_introCts.Token);
        }
    }

    private async Task RunConsoleIntroAsync(CancellationToken ct)
    {
        try
        {
            await Task.Delay(400, ct);

            for (int i = 1; i <= IntroCommand.Length; i++)
            {
                _typedCommand = IntroCommand[..i];
                StateHasChanged();
                await Task.Delay(155, ct);
            }

            await Task.Delay(450, ct);
            _commandSubmitted = true;
            StateHasChanged();

            await Task.Delay(550, ct);
            _showSecondLog = true;
            StateHasChanged();

            await Task.Delay(500, ct);

            bool audioStarted = await JS.InvokeAsync<bool>("treeTerminal.tryAutoPlay");
            if (audioStarted)
            {
                await FinishConsoleIntroAsync(ct);
            }
            else
            {
                _waitingForLaunchGesture = true;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException)
        {
            // Intro was skipped or component disposed
        }
    }

    private async Task FinishConsoleIntroAsync(CancellationToken ct = default)
    {
        if (!_isConsoleIntroActive || _isFadingOut)
            return;

        _isTreeRenderEnabled = true;
        _isFadingOut = true;
        StateHasChanged();

        try
        {
            await Task.Delay(260, ct);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _isConsoleIntroActive = false;
        _isFadingOut = false;
        StateHasChanged();
    }

    private async Task SkipConsoleIntroAsync()
    {
        if (!_isConsoleIntroActive)
            return;

        _introCts?.Cancel();
        _isTreeRenderEnabled = true;
        _isConsoleIntroActive = false;
        _isFadingOut = false;
        _waitingForLaunchGesture = false;
        StateHasChanged();

        await JS.InvokeVoidAsync("treeTerminal.playAudio");
    }

    [JSInvokable]
    public byte[]? OnFrame(float dt, int width, int height)
    {
        if (!_isTreeRenderEnabled)
            return null;

        return _engine.Tick(dt, width, height);
    }

    [JSInvokable]
    public bool OnCanvasHover(int col, int row)
    {
        return _engine.UpdateHover(col, row);
    }

    [JSInvokable]
    public string? OnCanvasClick(int col, int row)
    {
        return _engine.HandleClick(col, row);
    }

    [JSInvokable]
    public void SyncAudioMuted(bool muted)
    {
        _engine.IsAudioMuted = muted;
    }

    [JSInvokable]
    public void SyncCrtState(bool crtActive)
    {
        _isCrtActive = crtActive;
        _engine.IsCrtActive = crtActive;
        StateHasChanged();
    }

    private async Task ToggleAudio()
    {
        bool muted = await JS.InvokeAsync<bool>("treeTerminal.toggleMute");
        _engine.IsAudioMuted = muted;
    }

    private async Task ToggleCrt()
    {
        bool crt = await JS.InvokeAsync<bool>("treeTerminal.toggleCrt");
        _isCrtActive = crt;
        _engine.IsCrtActive = crt;
    }

    private async Task ToggleFullscreen()
    {
        await JS.InvokeVoidAsync("treeTerminal.toggleFullscreen");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isConsoleIntroActive && (_waitingForLaunchGesture || e.Key is "Enter" or " "))
        {
            await SkipConsoleIntroAsync();
            return;
        }

        switch (e.Key.ToLowerInvariant())
        {
            case " ":
                _engine.TogglePause();
                break;
            case "r":
                _engine.RestartGrowth();
                break;
            case "m":
                _ = ToggleAudio();
                break;
            case "b":
                _engine.ToggleBanner();
                break;
            case "h":
                _engine.ToggleHud();
                break;
            case "a":
            case "arrowleft":
                _engine.AdjustWind(-3.5f);
                break;
            case "d":
            case "arrowright":
                _engine.AdjustWind(3.5f);
                break;
            case "+":
            case "=":
                _engine.AdjustSnowDensity(0.25f);
                break;
            case "-":
            case "_":
                _engine.AdjustSnowDensity(-0.25f);
                break;
            case "c":
                _ = ToggleCrt();
                break;
            case "f":
                _ = ToggleFullscreen();
                break;
        }
    }

    public void Dispose()
    {
        _introCts?.Cancel();
        _introCts?.Dispose();
        _dotNetRef?.Dispose();
    }
}
